# Copy to .env. Never commit .env.
POSTGRES_USER=tracemind
POSTGRES_PASSWORD=change-me-local-only
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Demo app (database "app")
APP_DATABASE_URL=postgresql://tracemind:change-me-local-only@postgres:5432/app
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
DEPLOYMENT_ENVIRONMENT=demo
SERVICE_VERSION=1.0.0

# TraceMind (database "tracemind")
TRACEMIND_DATABASE_URL=postgresql://tracemind:change-me-local-only@postgres:5432/tracemind
# Repo TraceMind investigates: run scripts/prepare_demo_repo.sh, then register .tracemind/demo-repo

# Model provider (see docs/ARCHITECTURE.md §6). Values come from the provider's docs.
MODEL_PROVIDER=gemma_api        # gemma_api | gemma_local
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=

# Demo fault injection (honoured only when "true")
FAULT_INJECTION_ENABLED=true

# Host port for Postgres (change if 5432 is taken)
POSTGRES_PORT=5432

# Optional model tuning. Gemma 4 "thinks" by default (slow); minimal|high per the Gemma-on-Gemini-API docs.
MODEL_TIMEOUT_S=300
MODEL_THINKING_LEVEL=

# Absolute path of this checkout; only needed with docker-compose.remediation.yml
TRACEMIND_HOST_ROOT=

# Scaling / resource knobs (all optional)
TRACEMIND_DB_POOL_MAX=8            # per backend replica; keep replicas*pool below Postgres max_connections
TRACEMIND_MAX_CONCURRENT_JOBS=2    # concurrent investigation/remediation jobs per backend process
WORKER_PREFETCH=1                  # RabbitMQ prefetch per demo-worker consumer
BACKEND_MEM_LIMIT=1g
COLLECTOR_MEM_LIMIT=512m
TRACEMIND_JOB_TIMEOUT_S=1800       # running jobs older than this are marked failed at backend start
